<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="%d %-5p --- [%t] %c{1.} - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="org.jodconverter" level="TRACE"/>
        <Root level="INFO">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>
